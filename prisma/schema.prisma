generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  nationalId    String          @unique
  fullName      String
  email         String?         @unique
  passwordHash  String
  role          String          @default("STUDENT") // STUDENT, ADMIN, DOCTOR, SUPERADMIN
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  studentProfile StudentProfile?
}

model StudentProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId          String           @unique
  fullName            String
  nationality         String           @default("مصري")
  dob                 DateTime
  governorate         String
  city                String
  studentPhone        String
  fatherPhone         String
  motherPhone         String
  email               String?
  height              Float?
  weight              Float?
  institute           String           @default("المعهد الفني الصناعي")
  level               String           @default("الفرقة الأولى / المستجدين")
  department          String?          @default("الشعبة العامة")
  qualificationSource String           @default("من مصر")
  examType            String           @default("الكشف الطبي للطلاب المستجدين")
  specialCategory     String           @default("لا شيء مما سبق")
  status              String           @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, NEEDS_CORRECTION, COMPLETED_FIT, COMPLETED_UNFIT
  reviewNotes         String?
  doctorNotes         String?
  appointmentId       String?
  appointment         AppointmentSlot? @relation(fields: [appointmentId], references: [id])
  documents           Document[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model AppointmentSlot {
  id          String           @id @default(cuid())
  date        String           // Format: YYYY-MM-DD
  timeSlot    String           // e.g. "09:00:00"
  maxCapacity Int              @default(20)
  bookedCount Int              @default(0)
  isActive    Boolean          @default(true)
  students    StudentProfile[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([date, timeSlot])
}

model Document {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  docType     String         // "بطاقة الرقم القومي (الوجه الأمامي)", "بطاقة الرقم القومي (الوجه الخلفي)", "شهادة المؤهل الدراسي", "شهادة الميلاد المميكنة", "صورة شخصية", "مستند إثبات حالة خاصة"
  fileUrl     String
  publicId    String?
  fileName    String
  createdAt   DateTime       @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
